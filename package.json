{
  "name": "fat-design",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite",
    "build": "tsc && TARGET_ENV=npm vite build && node script/make-build.cjs && cp -r distTmp/0buildTypes types/ && cp -r types dist/ && cp -r libs dist/",
    "build:prod": "tsc && TARGET_ENV=npm vite build && node script/make-build.cjs -p && cp -r distTmp/0buildTypes types/ && cp -r types dist/ && cp -r libs dist/",
    "build:demo": "tsc && TARGET_ENV=demo vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "big.js": "^6.2.1",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.7",
    "hoist-non-react-statics": "^3.3.2",
    "localforage": "^1.10.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.debounce": "^4.0.8",
    "lodash.set": "^4.3.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-lifecycles-compat": "^3.0.4",
    "react-router-dom": "^6.14.1"
  },
  "npmPackageDependencies": {
    "react": "*"
  },
  "npmPackageDependenciesUMD": {
    "react": "React",
    "react/jsx-runtime": "ReactJsxRuntime"
  },
  "devDependencies": {
    "@types/hoist-non-react-statics": "^3.3.1",
